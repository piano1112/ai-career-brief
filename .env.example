# --- LLM (Milestone 2부터 사용) ---
ANTHROPIC_API_KEY=
# 모델명은 코드에 하드코딩하지 않는다. 사용할 모델 ID를 여기에 적는다.
CLAUDE_MODEL=

# --- DB ---
# docker compose로 실행하면 docker-compose.yml에서 db 컨테이너 주소로 덮어쓴다.
DATABASE_URL=postgresql+psycopg://brief:brief@localhost:5432/brief

# --- 시간 ---
TZ=Asia/Seoul
BRIEFING_PUBLISH_TIME=07:00

# --- 외부 API (Milestone 5) ---
WORK24_API_KEY=

# --- 로그인 (단일 계정) ---
ADMIN_USERNAME=me
# 생성: python -m app.auth hash '내비밀번호'
# bcrypt 해시에는 '$'가 들어있으므로 반드시 작은따옴표로 감싼다 (docker compose가 '$'를 변수로 해석하지 않게).
# 예: ADMIN_PASSWORD_HASH='$2b$12$....'
ADMIN_PASSWORD_HASH=
# 세션 쿠키 서명용. 생성: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=
# HTTPS 뒤에서 운영할 때 true (쿠키를 HTTPS로만 전송)
SESSION_HTTPS_ONLY=false
